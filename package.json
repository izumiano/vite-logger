{
	"name": "vite-logger",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"typecheck": "tsc --watch --noEmit -p tsconfig.json",
		"build": "tsc -b && vite build",
		"lint": "biome check",
		"lintFix": "biome check --write",
		"preview": "npm run build && vite preview --host",
		"test": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@pbr1111/vite-plugin-biome": "^1.1.3",
		"@types/node": "^25.0.9",
		"typescript": "~5.9.3",
		"vite": "^7.2.4",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^4.0.17"
	}
}
